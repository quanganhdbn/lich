rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() > 3 &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidTrip(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.tripDate is string &&
             data.tripDate.size() >= 8 &&
             data.startTime is string &&
             data.startLocation is string &&
             data.destination is string &&
             data.status in ['SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'] &&
             (!('endTime' in data) || data.endTime is string) &&
             (!('waypoints' in data) || data.waypoints is string) &&
             (!('customerName' in data) || data.customerName is string) &&
             (!('customerPhone' in data) || data.customerPhone is string) &&
             (!('flightNumber' in data) || data.flightNumber is string) &&
             (!('flightStatus' in data) || data.flightStatus is string) &&
             (!('reminderEnabled' in data) || data.reminderEnabled is bool) &&
             (!('reminderTimeMillis' in data) || data.reminderTimeMillis is int) &&
             (!('completedBy' in data) || data.completedBy is string) &&
             (!('completedAt' in data) || data.completedAt is int) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      match /trips/{tripId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTrip(request.resource.data);
        allow update: if isOwner(userId) && isValidTrip(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
